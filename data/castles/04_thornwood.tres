[resource]
script = ExtResource("castle_script")
id = &"thornwood"
display_name = "Thornwood Hollow"
description = "Spirits wind along lanes between thorn groves. Archers on the grove edge see them coming."
order = 3
map_position = Vector2(110, 36)
nights = 10
ground_tint = Color(0.82, 0.95, 0.78, 1)
layout = ExtResource("layout")
starting_pool = Array[ExtResource("pool_script")]([SubResource("pool_0"), SubResource("pool_1"), SubResource("pool_2"), SubResource("pool_3")])
merchant_symbols = Array[ExtResource("symbol_script")]([ExtResource("sym_coin"), ExtResource("sym_sword"), ExtResource("sym_bow"), ExtResource("sym_pike"), ExtResource("sym_crossbow"), ExtResource("sym_hammer"), ExtResource("sym_helm"), ExtResource("sym_staff"), ExtResource("sym_quiver"), ExtResource("sym_banner"), ExtResource("sym_sigil")])
payline_tier = 2
enemies = Array[ExtResource("spawn_script")]([SubResource("spawn_0"), SubResource("spawn_1"), SubResource("spawn_2"), SubResource("spawn_3"), SubResource("spawn_4")])
boss = ExtResource("unit_banshee_queen")
budget_base = 2
budget_per_night = 5
budget_ramp_divisor = 5
power_base = 1.3
power_per_night = 0.19
spawn_interval = 1.35
curse_start_night = 3
curses_per_dawn = 1
shard_multiplier = 1.6
crown_reward = 2
