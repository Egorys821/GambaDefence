enemies = Array[ExtResource("spawn_script")]([SubResource("spawn_0"), SubResource("spawn_1"), SubResource("spawn_2"), SubResource("spawn_3"), SubResource("spawn_4"), SubResource("spawn_rune_warden"), SubResource("spawn_dread_howler"), SubResource("spawn_shade_assassin"), SubResource("spawn_zombie_miner")])
boss = ExtResource("unit_grave_golem")
