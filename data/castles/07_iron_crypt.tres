[resource]
script = ExtResource("castle_script")
id = &"iron_crypt"
display_name = "Iron Crypt"
description = "Iron-clad dead shrug off arrows. Knights, pikes, crossbows and ballistae hit hard enough."
order = 6
map_position = Vector2(262, 84)
nights = 10
ground_tint = Color(0.85, 0.85, 0.95, 1)
