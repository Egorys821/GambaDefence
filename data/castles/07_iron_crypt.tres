merchant_symbols = Array[ExtResource("symbol_script")]([ExtResource("sym_coin"), ExtResource("sym_sword"), ExtResource("sym_pike"), ExtResource("sym_helm"), ExtResource("sym_crossbow"), ExtResource("sym_bow"), ExtResource("sym_hammer"), ExtResource("sym_staff"), ExtResource("sym_banner"), ExtResource("sym_quiver")])
