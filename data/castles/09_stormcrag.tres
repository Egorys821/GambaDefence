[resource]
script = ExtResource("castle_script")
id = &"stormcrag"
display_name = "Stormcrag"
description = "A pass through the crags, then a river bridged only at its ends. Storm spirits fly over it all."
order = 8
map_position = Vector2(364, 110)
nights = 10
ground_tint = Color(0.9, 0.9, 1.05, 1)
layout = ExtResource("layout")
starting_pool = Array[ExtResource("pool_script")]([SubResource("pool_0"), SubResource("pool_1"), SubResource("pool_2"), SubResource("pool_3"), SubResource("pool_4")])
merchant_symbols = Array[ExtResource("symbol_script")]([ExtResource("sym_coin"), ExtResource("sym_sword"), ExtResource("sym_bow"), ExtResource("sym_pike"), ExtResource("sym_crossbow"), ExtResource("sym_holy"), ExtResource("sym_hammer"), ExtResource("sym_helm"), ExtResource("sym_staff"), ExtResource("sym_quiver"), ExtResource("sym_banner"), ExtResource("sym_sigil")])
payline_tier = 3
enemies = Array[ExtResource("spawn_script")]([SubResource("spawn_0"), SubResource("spawn_1"), SubResource("spawn_2"), SubResource("spawn_3"), SubResource("spawn_4"), SubResource("spawn_5"), SubResource("spawn_rune_warden"), SubResource("spawn_dread_howler"), SubResource("spawn_shade_assassin"), SubResource("spawn_zombie_miner"), SubResource("spawn_orc_catapult")])
boss = ExtResource("unit_storm_wraith")
budget_base = 7
budget_per_night = 7
budget_ramp_divisor = 4
wave_growth = 1.2
army_threat = 0.65
power_base = 2.2
power_per_night = 0.27
spawn_interval = 1.15
curse_start_night = 2
curse_symbol = ExtResource("curse_sym")
curses_per_dawn = 1
shard_multiplier = 2.6
crown_reward = 3
