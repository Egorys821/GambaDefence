[resource]
script = ExtResource("castle_script")
id = &"willowdale"
display_name = "Willowdale Keep"
description = "A quiet keep in the green valley. The restless dead stir in its old graveyard."
order = 0
map_position = Vector2(40, 160)
nights = 10
ground_tint = Color(1, 1, 1, 1)
starting_pool = Array[ExtResource("pool_script")]([SubResource("pool_0"), SubResource("pool_1"), SubResource("pool_2")])
merchant_symbols = Array[ExtResource("symbol_script")]([ExtResource("sym_coin"), ExtResource("sym_sword"), ExtResource("sym_bow"), ExtResource("sym_hammer"), ExtResource("sym_helm"), ExtResource("sym_staff"), ExtResource("sym_quiver"), ExtResource("sym_banner"), ExtResource("sym_sigil"), ExtResource("sym_clover")])
payline_tier = 1
enemies = Array[ExtResource("spawn_script")]([SubResource("spawn_0"), SubResource("spawn_1"), SubResource("spawn_2")])
boss = ExtResource("unit_lich")
budget_base = 1
budget_per_night = 4
budget_ramp_divisor = 5
power_base = 1.0
power_per_night = 0.18
spawn_interval = 1.4
shard_multiplier = 1.0
