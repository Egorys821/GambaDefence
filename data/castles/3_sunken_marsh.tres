[resource]
script = ExtResource("castle_script")
id = &"sunken_marsh"
display_name = "Sunken Marsh"
description = "Will-o'-wisps fly over your soldiers straight at the walls. Bring archers, crossbows, mages and towers."
order = 2
map_position = Vector2(200, 150)
nights = 10
ground_tint = Color(0.8, 1.0, 0.75, 1)
starting_pool = Array[ExtResource("pool_script")]([SubResource("pool_0"), SubResource("pool_1"), SubResource("pool_2"), SubResource("pool_3")])
merchant_symbols = Array[ExtResource("symbol_script")]([ExtResource("sym_coin"), ExtResource("sym_sword"), ExtResource("sym_bow"), ExtResource("sym_crossbow"), ExtResource("sym_staff"), ExtResource("sym_hammer"), ExtResource("sym_pike"), ExtResource("sym_quiver"), ExtResource("sym_sigil"), ExtResource("sym_clover")])
payline_tier = 2
enemies = Array[ExtResource("spawn_script")]([SubResource("spawn_0"), SubResource("spawn_1"), SubResource("spawn_2"), SubResource("spawn_3"), SubResource("spawn_4")])
boss = ExtResource("unit_storm_wraith")
budget_base = 3
budget_per_night = 5
budget_ramp_divisor = 5
power_base = 1.5
power_per_night = 0.2
spawn_interval = 1.25
curse_start_night = 3
curses_per_dawn = 1
shard_multiplier = 1.75
