[resource]
script = ExtResource("castle_script")
id = &"ashen_throne"
display_name = "Ashen Throne"
description = "The burning heart of the curse. Imps swarm and demons guard the Demon Lord."
order = 4
map_position = Vector2(360, 150)
nights = 10
ground_tint = Color(1.15, 0.8, 0.7, 1)
starting_pool = Array[ExtResource("pool_script")]([SubResource("pool_0"), SubResource("pool_1"), SubResource("pool_2"), SubResource("pool_3"), SubResource("pool_4")])
merchant_symbols = Array[ExtResource("symbol_script")]([ExtResource("sym_coin"), ExtResource("sym_sword"), ExtResource("sym_bow"), ExtResource("sym_pike"), ExtResource("sym_crossbow"), ExtResource("sym_holy"), ExtResource("sym_hammer"), ExtResource("sym_helm"), ExtResource("sym_staff"), ExtResource("sym_quiver"), ExtResource("sym_banner"), ExtResource("sym_sigil")])
payline_tier = 3
enemies = Array[ExtResource("spawn_script")]([SubResource("spawn_0"), SubResource("spawn_1"), SubResource("spawn_2"), SubResource("spawn_3"), SubResource("spawn_4")])
boss = ExtResource("unit_demon_lord")
budget_base = 6
budget_per_night = 6
budget_ramp_divisor = 4
power_base = 1.7
power_per_night = 0.22
spawn_interval = 1.2
shard_multiplier = 2.5
curse_start_night = 2
curses_per_dawn = 1
