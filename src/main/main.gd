extends Node
## Root of the game. Flow: Time Forge (permanent upgrades) -> Kingdom Map
## (pick a castle) -> run of day/night cycles -> results (Chrono Shards earned)
## -> back to the Time Forge. Winning a castle opens the next one on the map.
## Losing is expected: every run makes the next one stronger.

const INTRO_TITLE := "Gamba Defence"
const INTRO_TEXT := "A strange storm hurled you back in time, into a medieval kingdom.\n\nIn the castle cellar hums a magic slot machine. By day, spin its reels: coins fill the treasury, swords and bows summon soldiers to the gates, and the wandering merchant sells upgrades.\n\nBy night, evil spirits rise and march on the castle. Survive %d nights.\n\nYou will fall - but every fallen kingdom leaves Chrono Shards to make the next attempt stronger."
const ABOUT_TEXT := "Lost in time in a medieval kingdom, you found a magic slot machine.

DAY: spin the reels. 3+ matching symbols from the LEFT reel on a payline pay out: gold, troops or castle repairs. The Magic Rune is wild. Spend gold at the merchant.

NIGHT: spirits rise from the graveyard. Your troops and towers fight them. Survive every night and defeat the boss to conquer the castle.

LOSING IS PART OF IT: every run earns Chrono Shards for permanent upgrades in the Time Forge.

Controls: mouse, Space to spin, Esc closes settings.
Made with Godot 4.6 - pixel art and chiptune sound generated by code."
const GARRISON_SYMBOL := &"sword"

var _run_over := false

@onready var _battlefield: Battlefield = $Battlefield
@onready var _hud: Hud = %Hud
@onready var _day_phase: DayPhase = %DayPhase
@onready var _night_panel: NightPanel = %NightPanel
@onready var _forge: TimeForge = %TimeForge
@onready var _map: KingdomMap = %KingdomMap
@onready var _settings: SettingsScreen = %SettingsScreen
@onready var _menu: MainMenu = %MainMenu
@onready var _codex: Codex = %Codex
@onready var _message: MessageScreen = %MessageScreen


func _ready() -> void:
	_day_phase.hud = _hud
	_day_phase.battlefield = _battlefield
	_day_phase.troops_requested.connect(_battlefield.spawn_troops)
	_day_phase.night_requested.connect(_start_night)
	_battlefield.night_cleared.connect(_on_night_cleared)
	_battlefield.status_changed.connect(_night_panel.set_status)
	_battlefield.status_changed.connect(_on_battle_status_changed)
	_battlefield.morale_changed.connect(func(_morale: float) -> void: _refresh_army())
	GameState.upgrades_changed.connect(_refresh_army)
	GameState.castle_hp_changed.connect(_on_castle_hp_changed)
	_hud.settings_pressed.connect(_settings.open)
	_forge.settings_pressed.connect(_settings.open)
	_settings.quit_run_requested.connect(_on_quit_run_requested)
	_day_phase.hide()
	_hud.hide()
	_night_panel.end_night()
	Audio.play_music(&"day")
	_battlefield.show_overview()
	if MetaProgress.runs == 0:
		_message.show_message(INTRO_TITLE, INTRO_TEXT % GameState.castles[0].nights, "Begin")
		await _message.confirmed
		Audio.play(&"click")
	_main_menu_loop()


## Main menu until the player picks a castle to play.
func _main_menu_loop() -> void:
	while true:
		_menu.open()
		var choice: StringName = await _menu.chosen
		match choice:
			MainMenu.CHOICE_PLAY:
				_map.open()
				var castle: CastleData = await _map.closed
				if castle:
					_begin_run(castle)
					return
			MainMenu.CHOICE_UPGRADES:
				_forge.open()
				await _forge.closed
			MainMenu.CHOICE_SETTINGS:
				_settings.open()
				await _settings.closed
			MainMenu.CHOICE_PREVIEW:
				_codex.open()
				await _codex.closed
			MainMenu.CHOICE_ABOUT:
				_message.show_message("About", ABOUT_TEXT, "Back")
				await _message.confirmed
			MainMenu.CHOICE_QUIT:
				get_tree().quit()
				return


func _begin_run(castle: CastleData) -> void:
	GameState.start_run(castle)  # applies the permanent upgrades
	_settings.in_run = true
	_battlefield.apply_castle(castle)
	_hud.show()
	var garrison := GameState.stat_int(Stats.GARRISON)
	if garrison > 0:
		var symbol := GameState.get_symbol(GARRISON_SYMBOL)
		_battlefield.spawn_troops(symbol.unit, garrison, GameState.power_for(GARRISON_SYMBOL))
	_start_day()


func _start_day() -> void:
	_hud.set_phase(false)
	_night_panel.end_night()
	_day_phase.begin_day()


func _start_night() -> void:
	Audio.play(&"night_start")
	Audio.play_music(&"night")
	await _day_phase.slide_out()
	_hud.set_phase(true)
	_battlefield.start_night(GameState.night)
	_night_panel.begin_night(GameState.night)


func _refresh_army() -> void:
	_hud.set_army(_battlefield.get_troops().size(), _battlefield.upkeep_cost(), _battlefield.morale)


func _on_battle_status_changed(_enemies_left: int, defenders: int) -> void:
	_hud.set_army(defenders, _battlefield.upkeep_cost(), _battlefield.morale)


func _on_night_cleared() -> void:
	if _run_over:
		return
	_night_panel.end_night()
	if GameState.night >= GameState.max_nights():
		Audio.play(&"victory")
		var story := "%s is free! The %s is banished." % [GameState.castle.display_name, GameState.castle.boss.display_name]
		var next := GameState.castle_index(GameState.castle) + 1
		if next < GameState.castles.size():
			story += "
The road to %s is open on the map." % GameState.castles[next].display_name
		else:
			story += "
Every castle in the kingdom is free. You are a legend!"
		_finish_run(true, "Castle Conquered!", story)
		return
	var dawn_gold := GameState.stat_int(Stats.DAWN_GOLD) + GameState.night
	var dawn_heal := GameState.stat_int(Stats.DAWN_HEAL)
	GameState.night += 1
	GameState.add_gold(dawn_gold)
	var subtitle := "You survived the night!  +%d gold" % dawn_gold
	var upkeep := _battlefield.pay_upkeep()
	if upkeep["paid"] > 0:
		subtitle += "  -%d upkeep" % upkeep["paid"]
	if upkeep["paid"] < upkeep["cost"]:
		subtitle += "
Upkeep unpaid! Troops fight at %d%% strength." % roundi(_battlefield.morale * 100.0)
	var curses := GameState.spread_curse()
	if curses > 0:
		subtitle += "
The curse spreads: +%d Tombstone on the reels!" % curses
	if dawn_heal > 0 and not GameState.is_castle_full():
		GameState.repair_castle(dawn_heal)
		subtitle += "  +%d castle HP" % dawn_heal
	Audio.play(&"dawn")
	Audio.play_music(&"day")
	_night_panel.show_banner("Dawn", subtitle, Color("#f8d038"))
	await get_tree().create_timer(1.6).timeout
	if not _run_over:
		_start_day()


func _on_castle_hp_changed(hp: int, _max_hp: int) -> void:
	if hp > 0 or _run_over or not _hud.visible:
		return
	_battlefield.stop_battle()
	Audio.play(&"game_over")
	_finish_run(false, "The Castle Has Fallen", "The spirits overran the castle on night %d." % GameState.night)


## Giving up counts as a lost run (shards for the nights survived).
func _on_quit_run_requested() -> void:
	if _run_over:
		return
	_battlefield.stop_battle()
	_finish_run(false, "Run Abandoned", "You left %s on night %d." % [GameState.castle.display_name, GameState.night])


## Shows the results, awards Chrono Shards and returns to the Time Forge.
func _finish_run(victory: bool, title: String, story: String) -> void:
	_run_over = true
	_settings.in_run = false
	Engine.time_scale = 1.0
	_night_panel.end_night()
	var nights_survived := GameState.max_nights() if victory else GameState.night - 1
	var shards := MetaProgress.record_run(nights_survived, GameState.kills, victory, GameState.castle)
	var body := "%s\n\nNights survived: %d / %d\nSpirits destroyed: %d\n\n+%d Chrono Shards" % [
		story, nights_survived, GameState.max_nights(), GameState.kills, shards]
	_message.show_message(title, body, "Back to menu")
	await _message.confirmed
	Audio.play(&"click")
	GameState.reset()
	get_tree().reload_current_scene()
