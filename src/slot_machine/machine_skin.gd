class_name MachineSkin
extends RefCounted
## How a machine style looks: its cabinet art and the ornaments the
## MachineCabinet draws and animates around the reels. The art lives in
## res://assets/sprites/machines/<style id>/ (frame, reel, marquee, wing,
## crest) and res://assets/sprites/machines/parts/, all generated by
## tools/generate_art.py. Unknown styles use the standard machine's look.

enum Ornament {
	LEVER,    ## A pull lever on the right side, pulled on every spin.
	BULBS,    ## Chasing light bulbs along the top of the cabinet.
	GLINT,    ## A shine sweeping across the marquee now and then.
	COBWEB,   ## A cobweb in the top-left corner.
	BELLS,    ## The crest wobbles like a jester's hat.
	DRAGON,   ## Dragon wings, glowing eyes and smoke puffs.
	CANDLES,  ## Flickering candles on the top corners.
	RUNES,    ## Runes on the frame that pulse with light.
	STONE,    ## A stone wall behind the reels (variable-height reels).
}

const ART_DIR := "res://assets/sprites/machines/"
const FRAME_MARGIN := 8
const WING_MARGIN := 6
const MARQUEE_CAP := 14

## Per style: marquee text colour (name, and status while a feature runs),
## accent (lamps, glows, win flashes), panel text colour, side panel width
## and ornaments.
const LOOKS := {
	&"standard": {"status": "#fff0a0", "text": "#f8d038", "accent": "#f8d038", "panel_text": "#f4e4c0", "wing_width": 46,
		"ornaments": [Ornament.LEVER, Ornament.GLINT]},
	&"old_cellar": {"status": "#ffb070", "text": "#ff7048", "accent": "#ff5040", "panel_text": "#e0e4e8", "wing_width": 46,
		"ornaments": [Ornament.LEVER, Ornament.BULBS, Ornament.COBWEB]},
	&"jester_81": {"status": "#fff4c0", "text": "#f8e070", "accent": "#f8d038", "panel_text": "#f8e8c8", "wing_width": 48,
		"ornaments": [Ornament.BELLS, Ornament.BULBS]},
	&"dragons_hoard": {"status": "#fff0a0", "text": "#f8d038", "accent": "#50e090", "panel_text": "#e0f4e4", "wing_width": 50,
		"ornaments": [Ornament.DRAGON]},
	&"tome_of_ages": {"status": "#a02818", "text": "#5a2c14", "accent": "#f8d038", "panel_text": "#3a1a0c", "wing_width": 46,
		"ornaments": [Ornament.CANDLES]},
	&"shifting_halls": {"status": "#c0f8ff", "text": "#60e8ff", "accent": "#40d8f0", "panel_text": "#c0f0ff", "wing_width": 38,
		"ornaments": [Ornament.RUNES, Ornament.STONE]},
}

var id: StringName
var frame: Texture2D
var reel: Texture2D
var marquee: Texture2D
var wing: Texture2D
var crest: Texture2D
var text_color: Color
var status_color: Color
var accent: Color
var panel_text: Color
var wing_width := 46
var bg_color: Color
var frame_color: Color
var ornaments: Array = []

static var _cache: Dictionary = {}


static func for_style(style: MachineStyle) -> MachineSkin:
	var key: StringName = style.id if LOOKS.has(style.id) else MachineStyle.STANDARD_ID
	if not _cache.has(key):
		_cache[key] = MachineSkin.new(key)
	var skin: MachineSkin = _cache[key]
	skin.bg_color = style.bg_color
	skin.frame_color = style.frame_color
	return skin


static func part(name: String) -> Texture2D:
	return load(ART_DIR + "parts/" + name + ".png")


func _init(p_id: StringName) -> void:
	id = p_id
	var look: Dictionary = LOOKS[id]
	var dir := ART_DIR + String(id) + "/"
	frame = load(dir + "frame.png")
	reel = load(dir + "reel.png")
	marquee = load(dir + "marquee.png")
	wing = load(dir + "wing.png")
	crest = load(dir + "crest.png")
	text_color = Color(look["text"])
	status_color = Color(look["status"])
	accent = Color(look["accent"])
	panel_text = Color(look["panel_text"])
	wing_width = look["wing_width"]
	ornaments = look["ornaments"]


func has(ornament: Ornament) -> bool:
	return ornament in ornaments


## A panel in the machine's colours (questions asked over the reels).
func panel_style() -> StyleBoxFlat:
	var box := StyleBoxFlat.new()
	box.bg_color = Color(bg_color.darkened(0.2), 0.95)
	box.border_color = frame_color
	box.set_border_width_all(2)
	box.set_content_margin_all(5)
	box.shadow_color = Color(0, 0, 0, 0.5)
	box.shadow_size = 2
	return box


## The UI kit's grey button, tinted in the machine's colours (the SPIN button).
func style_button(button: Button) -> void:
	var tint := frame_color.lerp(bg_color, 0.35)
	var states := {
		"normal": ["button_tint_normal", tint, false],
		"hover": ["button_tint_hover", tint.lightened(0.15), false],
		"pressed": ["button_tint_pressed", tint.darkened(0.1), true],
		"disabled": ["button_tint_disabled", bg_color.lightened(0.15), false],
	}
	for state: String in states:
		var entry: Array = states[state]
		var box := StyleBoxTexture.new()
		box.texture = load("res://assets/sprites/ui/kit/%s.png" % entry[0])
		box.modulate_color = entry[1]
		box.set_texture_margin_all(3)
		box.texture_margin_top = 4
		box.texture_margin_bottom = 4
		box.content_margin_left = 7
		box.content_margin_right = 7
		box.content_margin_top = 4 if entry[2] else 2
		box.content_margin_bottom = 2 if entry[2] else 4
		button.add_theme_stylebox_override(state, box)
